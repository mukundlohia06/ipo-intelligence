# ==============================================================================
# IPO Intelligence — Production & Local Environment Configuration Template
# ==============================================================================
# Copy this file to:
#   - backend/.env (for Backend / Render deployment environment variables)
#   - frontend/.env.local (for Frontend / Vercel deployment environment variables)
# Never commit real secrets to Git.
# ==============================================================================

# --- BACKEND (Render) Environment Variables ---
ENVIRONMENT=production
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_ORIGIN=https://your-frontend.vercel.app

# MongoDB Atlas
# e.g. mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB=ipo_intelligence

# Google Gemini API
# Get your API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TEMPERATURE=0.3
GEMINI_MAX_OUTPUT_TOKENS=4096

# Embedding Provider
EMBEDDING_PROVIDER=gemini
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSIONS=768

# Administration
ADMIN_TOKEN=dev_admin_token_2026
RATE_LIMIT_PER_MIN=60

# --- FRONTEND (Vercel) Environment Variables ---
# Set this in Vercel Project Settings > Environment Variables:
NEXT_PUBLIC_API_URL=https://your-render-backend-url.onrender.com
NEXT_PUBLIC_API_BASE_URL=https://your-render-backend-url.onrender.com
