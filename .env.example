# Copy this file to the backend environment file used by your application.
# Replace blank values locally. Never commit real secrets to Git.

# Application
ENVIRONMENT=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000

# MongoDB Atlas
MONGODB_URI=
MONGODB_DB=ipo_intelligence

# LLM provider (configure according to the provider selected by the team)
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# Embedding provider
EMBEDDING_PROVIDER=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=

# Optional reranker
RERANKER_PROVIDER=
RERANKER_API_KEY=
RERANKER_MODEL=

# Frontend API address
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
